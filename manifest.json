{
  "manifest_version": 3,
  "name": "TabSheet",
  "description": "See and manage all your open tabs in a sortable, searchable table.",
  "version": "0.3.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabsheet@ajunior.github.io",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "Open TabSheet"
  },
  "background": {
    "scripts": [
      "service-worker.js"
    ],
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "bookmarks",
    "tabs",
    "storage"
  ]
}
